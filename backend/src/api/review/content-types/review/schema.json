{
    "kind": "collectionType",
    "collectionName": "reviews",
    "info": {
        "singularName": "review",
        "pluralName": "reviews",
        "displayName": "Review",
        "description": "Client reviews based on locations or services"
    },
    "options": {
        "draftAndPublish": true
    },
    "attributes": {
        "clientName": {
            "type": "string",
            "required": true
        },
        "text": {
            "type": "text",
            "required": true
        },
        "rating": {
            "type": "integer",
            "default": 5,
            "min": 1,
            "max": 5
        },
        "location": {
            "type": "string"
        },
        "service": {
            "type": "relation",
            "relation": "manyToOne",
            "target": "api::service.service",
            "inversedBy": "reviews"
        }
    }
}
