{
    "kind": "collectionType",
    "collectionName": "services",
    "info": {
        "singularName": "service",
        "pluralName": "services",
        "displayName": "Service"
    },
    "options": {
        "draftAndPublish": true
    },
    "pluginOptions": {},
    "attributes": {
        "title": {
            "type": "string",
            "required": true
        },
        "slug": {
            "type": "uid",
            "targetField": "title"
        },
        "seoDescription": {
            "type": "text"
        },
        "pricingData": {
            "type": "json"
        },
        "employees": {
            "type": "relation",
            "relation": "manyToMany",
            "target": "api::employee.employee",
            "inversedBy": "services"
        },
        "projects": {
            "type": "relation",
            "relation": "oneToMany",
            "target": "api::project.project",
            "mappedBy": "service"
        },
        "reviews": {
            "type": "relation",
            "relation": "oneToMany",
            "target": "api::review.review",
            "mappedBy": "service"
        },
        "detailedDescription": {
            "type": "richtext"
        },
        "stages": {
            "type": "json"
        },
        "gallery": {
            "type": "json"
        },
        "service_categories": {
            "type": "relation",
            "relation": "manyToMany",
            "target": "api::service-category.service-category",
            "mappedBy": "services"
        }
    }
}